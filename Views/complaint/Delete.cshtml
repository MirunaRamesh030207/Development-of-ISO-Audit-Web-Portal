@model PROJECT_CVRDE_FINAL.Models.Complaint

@{
    ViewData["Title"] = "Delete Complaint";
}

<h2>Delete Complaint</h2>

<h4>Are you sure you want to delete this complaint?</h4>

<hr />

<table class="table table-bordered">

    <tr>
        <th>Complaint ID</th>
        <td>@Model.ComplaintID</td>
    </tr>

    <tr>
        <th>Employee Name</th>
        <td>@Model.EmployeeName</td>
    </tr>

    <tr>
        <th>Department Name</th>
        <td>@Model.DepartmentName</td>
    </tr>

    <tr>
        <th>Description</th>
        <td>@Model.ComplaintDescription</td>
    </tr>

    <tr>
        <th>Status</th>
        <td>@Model.Status</td>
    </tr>

    <tr>
        <th>Priority</th>
        <td>@Model.Priority</td>
    </tr>

</table>

<form method="post" action="/Complaint/Delete">

    <input type="hidden" name="ComplaintID" value="@Model.ComplaintID" />

    <input type="submit" value="Delete" class="btn btn-danger" />

    <a href="/Complaint/Index" class="btn btn-secondary">
        Cancel
    </a>

</form>