@model PROJECT_CVRDE_FINAL.Models.Complaint

@{
    ViewData["Title"] = "Complaint Details";
}

<h2>Complaint Details</h2>

<hr />

<table class="table table-bordered">

    <tr>
        <th>Complaint ID</th>
        <td>@Model.ComplaintID</td>
    </tr>

    <tr>
        <th>Employee Name</th>
        <td>@Model.EmployeeName</td>
    </tr>

    <tr>
        <th>Department Name</th>
        <td>@Model.DepartmentName</td>
    </tr>

    <tr>
        <th>Complaint Description</th>
        <td>@Model.ComplaintDescription</td>
    </tr>

    <tr>
        <th>Raised Date</th>
        <td>@Model.RaisedDate.ToShortDateString()</td>
    </tr>

    <tr>
        <th>Expected Resolution Date</th>
        <td>@Model.ExpectedResolutionDate.ToShortDateString()</td>
    </tr>

    <tr>
        <th>Status</th>
        <td>@Model.Status</td>
    </tr>

    <tr>
        <th>Priority</th>
        <td>@Model.Priority</td>
    </tr>

</table>

<br />

<a href="/Complaint/Edit/@Model.ComplaintID" class="btn btn-success">
    Edit
</a>

<a href="/Complaint/Delete/@Model.ComplaintID" class="btn btn-danger">
    Delete
</a>

<a href="/Complaint/Index" class="btn btn-secondary">
    Back
</a>