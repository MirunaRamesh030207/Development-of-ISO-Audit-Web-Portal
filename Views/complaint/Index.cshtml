@model List<PROJECT_CVRDE_FINAL.Models.Complaint>

@{
    ViewData["Title"] = "Complaint List";
}

<h2>Complaint Management System</h2>

<br />

<!-- Search -->

<form method="get" action="/Complaint/Search">

    Search :

    <input type="text" name="search" />

    <input type="submit" value="Search" class="btn btn-primary" />

</form>

<br />

<!-- Status Filter -->

<form method="get" action="/Complaint/Filter">

    Status :

    <select name="status">

        <option value="">All</option>
        <option value="Open">Open</option>
        <option value="In Progress">In Progress</option>
        <option value="Resolved">Resolved</option>

    </select>

    <input type="submit" value="Filter Status" class="btn btn-success" />

</form>

<br />

<!-- Complaint Type Filter -->

<form method="get" action="/Complaint/FilterByType">

    Complaint Type :

    <select name="type">

        <option value="">All</option>
        <option value="Computer Error">Computer Error</option>
        <option value="Network Error">Network Error</option>

    </select>

    <input type="submit" value="Filter Type" class="btn btn-secondary" />

</form>

<br />

<a href="/Complaint/Create" class="btn btn-primary">

    Add Complaint

</a>

&nbsp;

<a href="/Complaint/Dashboard" class="btn btn-warning">

    Dashboard

</a>

<br />
<br />

<table class="table table-bordered table-striped">

    <thead>

        <tr>

            <th>Complaint ID</th>

            <th>Employee Name</th>

            <th>Department Name</th>

            <th>Description</th>

            <th>Raised Date</th>

            <th>Expected Date</th>

            <th>Status</th>

            <th>Priority</th>

            <th>Complaint Type</th>

            <th>Action</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.ComplaintID</td>

                <td>@item.EmployeeName</td>

                <td>@item.DepartmentName</td>

                <td>@item.ComplaintDescription</td>

                <td>@item.RaisedDate.ToShortDateString()</td>

                <td>@item.ExpectedResolutionDate.ToShortDateString()</td>

                <td>@item.Status</td>

                <td>@item.Priority</td>

                <td>@item.ComplaintType</td>

                <td>

                    <a href="/Complaint/Edit/@item.ComplaintID" class="btn btn-success">
                        Edit
                    </a>

                    <br /><br />

                    <a href="/Complaint/Details/@item.ComplaintID" class="btn btn-info">
                        Details
                    </a>

                    <br /><br />

                    <a href="/Complaint/Delete/@item.ComplaintID" class="btn btn-danger">
                        Delete
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>    